#!/usr/bin/env bash
#MISE description="Format Go, shell, and markdown"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

if [[ $# -ne 0 && "$1" != "--check" ]]; then
	printf 'usage: mise run fmt [--check]\n' >&2
	exit 1
fi

steps=(
	--step go-format
	--step shell-format
	--step markdown-format
)

if [[ "${1:-}" == "--check" ]]; then
	exec hk check --all "${steps[@]}"
fi

exec hk fix --all --no-stage "${steps[@]}"
