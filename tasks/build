#!/usr/bin/env bash
#MISE description="Build bin/sbxr"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# shellcheck disable=SC1091
source scripts/_lib.sh

name="$(_name_of "$(go list -m)")"

mkdir -p bin

go build -o "bin/$name" "./cmd/$name"

# Hardened runtime would strip the DYLD_* variables that libkrun needs, so do not add --options runtime.
if [[ "$(uname -s)" == Darwin ]]; then
	out="$(codesign --force --sign - --entitlements entitlements.plist "bin/$name" 2>&1)" || die "codesign: $out"
fi
