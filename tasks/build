#!/usr/bin/env bash
#MISE description="Build bin/sbxr"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

mkdir -p bin

# The release embeds the guest mount helper for -v, so build it first.
go generate ./internal/guestmount

# cgo stays off, like the release, so that the binary that the VM tests run matches it.
CGO_ENABLED=0 go build -o bin/sbxr ./cmd/sbxr

# Hardened runtime would strip the DYLD_* variables that libkrun needs, so do not add --options runtime.
if [[ "$(uname -s)" == Darwin ]]; then
	if ! out="$(codesign --force --sign - --entitlements cmd/sbxr/entitlements.plist bin/sbxr 2>&1)"; then
		printf 'Error: codesign: %s\n' "$out" >&2
		exit 1
	fi
fi
