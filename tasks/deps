#!/usr/bin/env bash
#MISE description="Check that the tools are installed and vendor the Go modules"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

if ! mise install --dry-run-code >/dev/null; then
	printf 'Error: Some tools in mise.toml are missing. Run: mise install\n' >&2
	exit 1
fi

go mod vendor
printf 'The tools in mise.toml are installed, and vendor/ is up to date.\n'
