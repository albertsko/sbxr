#!/usr/bin/env bash
#MISE description="Check that the tools are installed and vendor the Go modules"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# shellcheck disable=SC1091
source scripts/_lib.sh

mise install --dry-run-code >/dev/null || die "Some tools in mise.toml are missing. Run: mise install"
go mod vendor
printf 'The tools in mise.toml are installed, and vendor/ is up to date.\n'
