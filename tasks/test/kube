#!/usr/bin/env bash
#MISE description="Run the kube target tests in a kind cluster. Skips without Linux or a hypervisor unless SBXR_TEST_REQUIRE=1"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."

# The first run builds the node bundle and the cluster, which takes longer than the test itself.
exec go test -tags kube -count=1 -timeout 45m -run '^TestKube' ./internal/scenario "$@"
