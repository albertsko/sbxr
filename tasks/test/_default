#!/usr/bin/env bash
#MISE description="Run unit tests and the fake target scenarios"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."

uncached=(./cmd/sbxr ./internal/scenario)
cached=()
while IFS= read -r pkg; do
	cached+=("$pkg")
done < <(go list ./... | grep -v -x -e "$(go list -m)/cmd/sbxr" -e "$(go list -m)/internal/scenario")

go test -race "${cached[@]}" "$@"
# These tests build the CLI in a go build subprocess, which the test cache does not track, so a cached PASS can be false.
go test -race -count=1 "${uncached[@]}" "$@"
