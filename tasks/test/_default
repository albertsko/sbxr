#!/usr/bin/env bash
#MISE description="Run unit tests and the fake target scenarios"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."

if [[ -n "${CI:-}" ]]; then
	# Diagnostics for a macOS CI flake that kills this task with SIGHUP: show which processes share its group.
	# go test runs in the foreground without exec, so the trap stays, and set -e keeps its status.
	# A SIGHUP that reaches only this task still fails it after go test ends.
	hup=0
	trap 'hup=1; echo "test task: SIGHUP" >&2; ps -axo pid,ppid,pgid,sess,tt,stat,etime,command >&2' HUP
	go test -race -shuffle=on ./... "$@"
	exit $((hup ? 129 : 0))
fi

exec go test -race ./... "$@"
