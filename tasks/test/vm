#!/usr/bin/env bash
#MISE description="Run the vm target tests against a real libkrun VM. Skips without a hypervisor unless SBXR_TEST_REQUIRE=1"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."

# Only the packages with vm test files, so no other TestMain runs. The e2e tests run the sbxr binary, SBXR_BIN when set.
# Extra arguments such as -shuffle=on or -v go to go test.
pkgs="$(scripts/target-packages.sh vm)"
# shellcheck disable=SC2086 # One package per word.
exec go test -tags vm -count=1 -timeout 20m -parallel 4 -exec "$PWD/scripts/gotest-exec.sh" \
	-run '^TestVM' $pkgs "$@"
