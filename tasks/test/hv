#!/usr/bin/env bash
#MISE description="Run the scenarios against a real VM. Skips without a hypervisor unless SBXR_REQUIRE_HV=1"
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.."

# The libkrun tests boot their own guest. The scenario tests run the sbxr binary, SBXR_BIN when set.
exec go test -tags hv -count=1 -timeout 10m -parallel 4 -exec "$PWD/scripts/gotest-exec.sh" \
	-run '^Test(HV|VM)' ./internal/scenario ./internal/vm/libkrun "$@"
